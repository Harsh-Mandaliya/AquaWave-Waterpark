# Used by "npm run dev:local" — connects the site to the local Firebase backend ("npm run backend").
# "demo-" project ids never touch a real Google Cloud project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-local-key
VITE_FIREBASE_AUTH_DOMAIN=demo-masti.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-masti
VITE_FIREBASE_APP_ID=demo-masti-web
