rules_version = '2';

// Security + validation for the Masti Water Park database.
// The website checks the same things in src/lib/validate.js; these rules make sure
// nobody can skip those checks by calling the database directly.

service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in user whose UID has a document in /admins.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public website content: anyone can read, only admins can change it.
    match /site/{docId}      { allow read: if true; allow write: if isAdmin(); }
    match /rides/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /tickets/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /offers/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{id}         { allow read: if true; allow write: if isAdmin(); }

    // ---------- Booking / contact enquiries from visitors ----------

    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isGuests(v) { return v is int && v >= 0 && v <= 200; }

    // "YYYY-MM-DD" that is today or later (1.5 day slack for time zones) and at most a year ahead
    function isVisitDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) > request.time - duration.value(36, 'h')
        && timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) < request.time + duration.value(367, 'd');
    }

    function validCommon(e) {
      return e.keys().hasOnly(['type', 'name', 'phone', 'email', 'message', 'channel', 'status', 'createdAt',
                               'date', 'adults', 'kids', 'ticket', 'groupType', 'estimate'])
        && e.type in ['booking', 'contact']
        && isText(e.name, 2, 60)
        && e.phone is string && e.phone.matches('^[6-9][0-9]{9}$')
        && (!('email' in e) || isText(e.email, 0, 100))
        && (!('message' in e) || isText(e.message, 0, 500))
        && e.status == 'new'
        && e.createdAt == request.time;           // must be the server time, cannot be faked
    }

    function validBooking(e) {
      return isVisitDate(e.date)
        && isGuests(e.adults) && isGuests(e.kids)
        && e.adults >= 1 && e.adults + e.kids <= 200
        && isText(e.ticket, 1, 60)
        && e.groupType in ['family', 'friends', 'school', 'corporate', 'birthday', 'offer']
        && e.estimate is int && e.estimate >= 0;
    }

    match /enquiries/{id} {
      allow create: if validCommon(request.resource.data)
                    && (request.resource.data.type == 'contact' || validBooking(request.resource.data));
      allow read, delete: if isAdmin();
      // admins may only change the status (and an internal note)
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note'])
                    && request.resource.data.status in ['new', 'contacted', 'confirmed', 'closed'];
    }

    // ---------- Admin activity log (who changed what, when) ----------
    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.by == request.auth.token.email
                    && request.resource.data.at == request.time;
      allow update, delete: if false;             // history cannot be edited
    }

    // Admin list: who is an admin is managed from the Firebase console only.
    // Each admin may edit their own profile fields (name, phone, photo) — never their role.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'photo', 'updatedAt'])
                    && isText(request.resource.data.get('name', ''), 0, 60)
                    && isText(request.resource.data.get('phone', ''), 0, 20)
                    && isText(request.resource.data.get('photo', ''), 0, 300000)
                    && request.resource.data.get('updatedAt', request.time) == request.time;
      allow create, delete: if false;
    }
  }
}
